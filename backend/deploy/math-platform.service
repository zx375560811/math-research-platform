[Unit]
Description=Math Research Platform C Backend
After=network.target

[Service]
Type=simple
User=math-platform
Group=math-platform
WorkingDirectory=/opt/math-platform/backend
ExecStart=/opt/math-platform/backend/build/math-server
Environment=MATH_PORT=8080
Environment=MATH_DB_PATH=/opt/math-platform/backend/data/math.db
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/math-platform/backend/data

[Install]
WantedBy=multi-user.target
