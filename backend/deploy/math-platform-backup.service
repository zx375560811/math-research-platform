[Unit]
Description=Math Research Platform SQLite Online Backup
After=math-platform.service

[Service]
Type=oneshot
User=math-platform
Group=math-platform
WorkingDirectory=/opt/math-platform/backend
ExecStart=/usr/bin/python3 /opt/math-platform/backend/admin/backup_database.py --database /opt/math-platform/backend/data/math.db --output-dir /opt/math-platform/backend/data/backups --keep 14
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/math-platform/backend/data
