# Axiom 数学研究平台：Caddy 2 反向代理示例
#
# 用法：
#   1. 将 math.example.com 和 ops@example.com 换成真实域名与邮箱；
#   2. 复制为 /etc/caddy/Caddyfile；
#   3. systemctl reload caddy
#
# 应用仍只监听 127.0.0.1:8080。Caddy 自动申请并续期 HTTPS 证书。
# 应用自身已经发送 CSP、X-Frame-Options 等安全响应头，这里不要重复覆盖。

{
	email ops@example.com
}

math.example.com {
	encode zstd gzip

	reverse_proxy 127.0.0.1:8080 {
		# AI 对话使用 SSE 流式返回，必须关闭响应缓冲。
		flush_interval -1
		transport http {
			# 单次模型请求最长 300 秒（与后端限制一致）。
			read_timeout 300s
			write_timeout 300s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		-Server
	}
}
