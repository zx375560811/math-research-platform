# Axiom 数学研究平台：Nginx 反向代理示例
#
# 用法：
#   1. 将 math.example.com 与证书路径换成真实值；
#   2. 复制为 /etc/nginx/conf.d/math-platform.conf；
#   3. nginx -t && systemctl reload nginx
#
# 证书可用 certbot 申请：certbot --nginx -d math.example.com
# 旧版 Nginx 使用 `listen 443 ssl http2;`；1.25.1+ 也可改成 `listen 443 ssl;` + `http2 on;`。

server {
    listen 80;
    server_name math.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name math.example.com;

    ssl_certificate     /etc/letsencrypt/live/math.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/math.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # 文献上传不设应用层大小上限；0 表示交给后端逐字节流式处理。
    client_max_body_size 0;

    # AI 请求最长 300 秒；大文件上传直接流式转发，不在 Nginx 落盘。
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    proxy_request_buffering off;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # AI 对话使用 SSE，关闭缓冲与缓存。
        proxy_buffering off;
        proxy_cache off;
    }
}
